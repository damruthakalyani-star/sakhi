# ==============================================================================
# SAKHISAHAY Backend Environment Configuration
# ==============================================================================

# Application Meta
APP_NAME=SAKHISAHAY API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Security & JWT
# Minimum 64 random characters in production. (e.g. openssl rand -hex 32)
SECRET_KEY=dev-insecure-secret-key-replace-with-64-random-chars-in-production-must-be-very-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sakhisahay_db
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_TIMEOUT_MS=5000

# CORS & Host Security (comma-separated, NO wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute

# Storage & Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,application/pdf

# SMTP Email Configuration (Mock/Console in dev, real SMTP in prod)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@sakhisahay.example
SMTP_PASSWORD=placeholder-smtp-password
EMAIL_FROM=no-reply@sakhisahay.example
SMTP_TLS=true

# Initial Admin Credentials (Seeded once on initial setup)
FIRST_ADMIN_EMAIL=admin@sakhisahay.example
FIRST_ADMIN_PASSWORD=AdminSecurePassword2026!
FIRST_ADMIN_NAME=System Administrator

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
